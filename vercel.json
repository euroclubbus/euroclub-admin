{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/send-push.ts": {
      "maxDuration": 30
    },
    "api/meta-ads-report.ts": {
      "maxDuration": 30
    },
    "api/admin.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/admin?action=clients-sync",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "content-type",
          "value": "application/x-www-form-urlencoded.*"
        }
      ],
      "destination": "/api/admin?action=sso"
    }
  ]
}