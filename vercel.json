{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/send-push.ts": {
      "maxDuration": 30
    },
    "api/meta-ads-report.ts": {
      "maxDuration": 30
    },
    "api/clients-sync.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/clients-sync",
      "schedule": "0 1 * * *"
    }
  ]
}